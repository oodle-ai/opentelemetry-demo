# Copy this file to .env.oodle and fill in the values.
# .env.oodle is gitignored; the Makefile loads it after the other env files when present.

# Oodle credentials for the collector's otlphttp/oodle exporter
OODLE_INSTANCE=
OODLE_API_KEY=

# Pin images to the version matching this checkout; latest-* has drifted from the fork source
DEMO_VERSION=${IMAGE_VERSION}
